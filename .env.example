# Na Vercel: crie um armazenamento Vercel Blob PRIVADO e vincule ao projeto.
# A Vercel cria BLOB_READ_WRITE_TOKEN automaticamente.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Somente backend: hash scrypt no formato salt:hash (64 bytes em hex).
# ADMIN_PASSWORD_HASH=
# Segredo aleatório, no mínimo 32 caracteres.
# ADMIN_SESSION_SECRET=

# Backend only: set both to use Neon, leaving unset preserves existing storage.
STORAGE_PROVIDER=
DATABASE_URL=
